APP_ENV=dev
APP_NAME=HealthMate Backend
API_PREFIX=/api
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
AI_MODE=mock
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=5
KNOWLEDGE_ENABLED=true
