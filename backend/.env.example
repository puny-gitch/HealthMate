KNOWLEDGE_TOP_K=3
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
REDIS_URL=
CACHE_TTL_SECONDS=604800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=healthmate
